# ═══════════════════════════════════════════════════════════════════════
# GEO Pulse AI — Environment Variables
# 
# WSZYSTKIE TE USŁUGI SĄ DARMOWE:
# - Vercel (hosting) — free tier
# - Supabase (database) — free tier (500MB)
# - Google Gemini AI — free tier (15 req/min)
# - Stripe — free (0% platform fee, tylko 2.9% + $0.30 per transakcja)
# ═══════════════════════════════════════════════════════════════════════

# ─── Database (Supabase - DARMOWE) ────────────────────────────────────
# 1. Utwórz projekt na https://supabase.com (darmowe konto)
# 2. Idź do: Settings → Database → Connection string
# 3. Wybierz "Transaction" mode i skopiuj connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase Auth (public browser credentials) ─────────────────────
# Settings → API → Project URL and Publishable/anon key
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_supabase_anon_key

# ─── Application URL ──────────────────────────────────────────────────
# Po deploymencie na Vercel, wklej tutaj swoją domenę
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Google Gemini AI (DARMOWE) ───────────────────────────────────────
# 1. Idź na https://aistudio.google.com/apikey
# 2. Kliknij "Create API Key"
# 3. Skopiuj klucz i wklej tutaj
# Free tier: 15 requests/minute, 1500 requests/day
GEMINI_API_KEY=AIza...your_gemini_api_key

# ─── Stripe Payments (DARMOWE do użycia, opłaty tylko od transakcji) ──
# 1. Utwórz konto na https://stripe.com (darmowe)
# 2. Idź do: Developers → API Keys
# 3. Skopiuj "Secret key" (zaczyna się od sk_test_ lub sk_live_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Publishable key (do użycia w kliencie - opcjonalne)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhook signing secret:
# 1. Idź do: Developers → Webhooks → Add endpoint
# 2. URL: https://your-app.vercel.app/api/webhook/stripe
# 3. Events: checkout.session.completed, payment_intent.payment_failed
# 4. Po utworzeniu, kliknij endpoint → Signing secret → Reveal
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── OpenAI (Opcjonalne - jeśli chcesz użyć zamiast Gemini) ──────────
# Uwaga: OpenAI NIE jest darmowe, ale Gemini tak!
# OPENAI_API_KEY=sk-your_openai_api_key
